{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "pwsh -NoProfile -File ./scripts/ai/sync-submodule-on-start.ps1"
      },
      {
        "command": "pwsh -NoProfile -File ./scripts/ai/log-ai-usage.ps1 -Vendor codex -Event sessionStart"
      }
    ],
    "PreToolUse": [
      {
        "command": "pwsh -NoProfile -File ./scripts/ai/log-ai-usage.ps1 -Vendor codex -Event PreToolUse"
      }
    ]
  }
}
