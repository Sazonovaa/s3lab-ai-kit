#!/usr/bin/env bash
#
# new-project
#
# Bootstrap a new project with s3lab-ai-kit installed.
# Run from anywhere; this script creates the new directory and sets up everything.
#
# Usage:
#   .ai-kit/bin/new-project <project-name> [<parent-dir>]
#   .ai-kit/bin/new-project my-service                  # creates ./my-service
#   .ai-kit/bin/new-project my-service ~/Projects       # creates ~/Projects/my-service
#

set -euo pipefail

PROJECT_NAME="${1:-}"
PARENT_DIR="${2:-$PWD}"

if [ -z "$PROJECT_NAME" ]; then
    echo "Usage: new-project <project-name> [<parent-dir>]"
    exit 1
fi

PROJECT_PATH="$PARENT_DIR/$PROJECT_NAME"

if [ -e "$PROJECT_PATH" ]; then
    echo "ERROR: $PROJECT_PATH already exists."
    exit 1
fi

# Find kit submodule URL — assume the kit running this script is itself a git repo
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KIT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
KIT_URL=$(cd "$KIT_DIR" && git remote get-url origin 2>/dev/null || echo "")

if [ -z "$KIT_URL" ]; then
    echo "ERROR: cannot determine kit URL. Run this from a cloned s3lab-ai-kit."
    exit 1
fi

echo "→ Creating $PROJECT_PATH"
mkdir -p "$PROJECT_PATH"
cd "$PROJECT_PATH"

echo "→ git init"
git init --quiet --initial-branch=main

echo "→ Adding s3lab-ai-kit as submodule"
git submodule add --quiet "$KIT_URL" .ai-kit

echo "→ Running sync-ai-kit"
.ai-kit/bin/sync-ai-kit

echo ""
echo "→ Initial commit"
git add -A
git commit --quiet -m "chore: bootstrap project with s3lab-ai-kit v$(cat .ai-kit/VERSION)"

echo ""
echo "✓ Project ready at $PROJECT_PATH"
echo ""
echo "Next steps:"
echo "  cd $PROJECT_PATH"
echo "  # edit .ai/project-context.md to describe this project"
echo "  # add your initial code (backend services, frontend, etc.)"
